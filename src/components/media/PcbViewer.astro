---
/**
 * PCB viewer built from the board's Gerbers (and STEP, if provided).
 * Data: src/data/pcbs/<id>.yaml · files: public/pcbs/<id>/ (made by `npm run pcb:import`).
 *
 *   <PcbViewer id="typhoon" caption="…" />
 *
 * One list switches the view: the assembled top side, each layer on its own (top silkscreen
 * down through the inner copper to the bottom silkscreen, always over the board outline and
 * holes), the assembled bottom side, and 3D (the STEP board in the model viewer).
 * Arrow keys step through the list. Drag to pan; zoom with +/−, Ctrl/⌘ + scroll, or pinch.
 */
import fs from 'node:fs';
import path from 'node:path';
import { getEntry } from 'astro:content';
import ModelViewer from './ModelViewer.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  id: string;
  caption?: string;
}

type Layer = { id: string; label: string; type: string; side: string; color: string; file: string };

const { id, caption } = Astro.props;
const entry = await getEntry('pcbs', id);
if (!entry) throw new Error(`<PcbViewer id="${id}">: no src/data/pcbs/${id}.yaml`);
const manifestFile = path.join(process.cwd(), 'public/pcbs', id, 'manifest.json');
if (!fs.existsSync(manifestFile)) throw new Error(`<PcbViewer id="${id}">: run npm run pcb:import first (no ${manifestFile})`);
const m = JSON.parse(fs.readFileSync(manifestFile, 'utf8')) as { width: number; height: number; units: string; copperLayers: number; layers: Layer[] };
const base = `/pcbs/${id}`;
const aspect = `${m.width} / ${m.height}`;
const size = `${+m.width.toFixed(1)} × ${+m.height.toFixed(1)} ${m.units}`;

// Physical stack order, top to bottom. Outline and holes aren't entries; they sit under every layer view.
const RANK: Record<string, number> = { silkscreen: 0, solderpaste: 1, soldermask: 2, copper: 3 };
const sideRank = (l: Layer) => (l.side === 'top' ? RANK[l.type]! : l.side === 'inner' ? 10 : 20 + (3 - RANK[l.type]!));
const stack = m.layers.filter((l) => l.side !== 'all').sort((a, b) => sideRank(a) - sideRank(b) || a.label.localeCompare(b.label));
const context = m.layers.filter((l) => l.side === 'all');

const views = [
  { id: 'top', label: 'Top side', note: 'assembled', color: undefined as string | undefined },
  ...stack.map((l) => ({ id: l.id, label: l.label, note: undefined as string | undefined, color: l.color })),
  { id: 'bottom', label: 'Bottom side', note: 'from below', color: undefined },
  ...(entry.data.model ? [{ id: '3d', label: '3D board', note: 'from STEP', color: undefined }] : []),
];
---

<figure class="pcb wide" data-pcb style={`--aspect:${aspect}`}>
  <div class="pcb__body">
    <div class="pcb__stage crop-marks" data-stage role="img" aria-label={entry.data.alt}>
      <div class="pcb__canvas" data-canvas>
        <img class="pcb__img" data-show="top" src={`${base}/top.svg`} alt="" loading="lazy" draggable="false" />
        <img class="pcb__img" data-show="bottom" data-src={`${base}/bottom.svg`} alt="" draggable="false" hidden />
        {context.map((l) => <img class:list={['pcb__img', 'pcb__context', `is-${l.type}`]} data-show="layer" data-src={`${base}/${l.file}`} alt="" draggable="false" hidden />)}
        {stack.map((l) => <img class="pcb__img pcb__layer-img" data-show={l.id} data-src={`${base}/${l.file}`} alt="" draggable="false" hidden />)}
      </div>
      <div class="pcb__zoom" data-zoom>
        <button type="button" class="parts__btn" data-z="in" aria-label="Zoom in">+</button>
        <button type="button" class="parts__btn" data-z="out" aria-label="Zoom out">−</button>
        <button type="button" class="parts__btn" data-z="reset" aria-label="Reset view"><Icon name="reset" size={14} /></button>
      </div>
      <p class="pcb__hint label" aria-hidden="true">Drag to pan · Ctrl + scroll to zoom</p>
    </div>

    {
      entry.data.model && (
        <div class="pcb__3d" data-show="3d" hidden>
          <ModelViewer id={entry.data.model.id} />
        </div>
      )
    }

    <div class="pcb__side">
      <p class="label">{size} · {m.copperLayers} copper layers</p>
      <div class="pcb__list" role="tablist" aria-orientation="vertical" aria-label="Board view">
        {
          views.map((v, i) => (
            <button
              type="button"
              role="tab"
              class:list={['pcb__item', v.color ? 'is-layer' : 'is-view']}
              data-view={v.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              style={v.color ? `--c:${v.color}` : undefined}
            >
              <span class="pcb__swatch" aria-hidden="true" />
              <span class="pcb__name">{v.label}</span>
              {v.note && <span class="pcb__note">{v.note}</span>}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  {
    caption && (
      <figcaption>
        <span class="label pcb__num" />
        <span>{caption}</span>
      </figcaption>
    )
  }
</figure>

<style>
  .pcb {
    counter-increment: fig;
    container-type: inline-size;
  }

  .pcb__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4);
  }

  @container (min-width: 760px) {
    .pcb__body {
      grid-template-columns: minmax(0, 1fr) 220px;
    }
    .pcb__stage,
    .pcb__3d {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .pcb__stage {
    position: relative;
    aspect-ratio: var(--aspect);
    max-height: 72vh;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #0b0c0e;
    cursor: grab;
    touch-action: none;
  }

  .pcb__stage.is-dragging {
    cursor: grabbing;
  }

  .pcb__stage[hidden],
  .pcb__img[hidden],
  .pcb__3d[hidden] {
    display: none;
  }

  .pcb__canvas {
    position: absolute;
    inset: 4%;
    transform-origin: 0 0;
    will-change: transform;
  }

  .pcb__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
  }

  /* Single-layer views: the layer over a faint outline, with holes punched through. */
  .pcb__context.is-outline {
    opacity: 0.5;
  }

  .pcb__context.is-drill {
    z-index: 1;
  }

  .pcb__3d :global(.parts) {
    margin: 0;
  }

  .pcb__zoom {
    position: absolute;
    right: var(--s-3);
    bottom: var(--s-3);
    z-index: 2;
    display: flex;
    gap: var(--s-1);
  }

  .pcb__zoom .parts__btn {
    min-width: 2rem;
    justify-content: center;
  }

  .pcb__hint {
    position: absolute;
    left: var(--s-3);
    bottom: var(--s-3);
    color: #8b929c;
    pointer-events: none;
  }

  /* ── view list (a stack-up: top of the board first) ── */
  .pcb__side {
    min-width: 0;
  }

  .pcb__list {
    display: flex;
    flex-direction: column;
    margin-top: var(--s-3);
    border-top: 1px solid var(--line);
  }

  .pcb__item {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-3);
    padding: 0.55rem var(--s-2);
    border-bottom: 1px solid var(--line);
    font-size: var(--step--1);
    text-align: left;
    color: var(--text-2);
    transition:
      color var(--dur-2) var(--ease),
      background-color var(--dur-2) var(--ease);
  }

  .pcb__item:hover {
    color: var(--text);
    background: var(--bg-elev);
  }

  .pcb__item[aria-selected='true'] {
    color: var(--text);
    background: var(--bg-elev);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .pcb__swatch {
    width: 14px;
    height: 6px;
    border-radius: 1px;
    background: var(--c, transparent);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
  }

  .pcb__item.is-view .pcb__swatch {
    height: 14px;
    background: linear-gradient(180deg, #2f8f4e 0 30%, #d9a441 30% 45%, #1f2a22 45% 100%);
  }

  .pcb__note {
    font: var(--step--2) var(--font-mono);
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Narrow: the list becomes a scrolling row under the board. */
  @container (max-width: 759px) {
    .pcb__list {
      flex-direction: row;
      overflow-x: auto;
      border-top: 0;
      gap: var(--s-1);
      padding-bottom: var(--s-1);
      scrollbar-width: thin;
    }
    .pcb__item {
      flex: none;
      grid-template-columns: 14px auto;
      border: 1px solid var(--line);
      border-radius: var(--radius);
    }
    .pcb__item[aria-selected='true'] {
      box-shadow: inset 0 -2px 0 var(--accent);
    }
    .pcb__note,
    .pcb__hint {
      display: none;
    }
  }

  figcaption {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-3);
    font-size: var(--step--1);
    color: var(--text-3);
  }

  .pcb__num::before {
    content: 'FIG.\00a0' counter(fig, decimal-leading-zero);
    color: var(--accent);
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-pcb]')) {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const canvas = root.querySelector<HTMLElement>('[data-canvas]')!;
    const three = root.querySelector<HTMLElement>('.pcb__3d');
    const items = [...root.querySelectorAll<HTMLButtonElement>('[data-view]')];
    const imgs = [...canvas.querySelectorAll<HTMLImageElement>('[data-show]')];

    // ── view switching ──
    const show = (view: string, focus = false) => {
      items.forEach((b) => {
        const on = b.dataset.view === view;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      });
      const is3d = view === '3d';
      stage.hidden = is3d;
      if (three) three.hidden = !is3d;
      const isLayer = view !== 'top' && view !== 'bottom' && !is3d;
      for (const img of imgs) {
        const on = img.dataset.show === view || (isLayer && img.dataset.show === 'layer');
        if (on && img.dataset.src) {
          img.src = img.dataset.src; // load on first view
          delete img.dataset.src;
        }
        img.hidden = !on;
      }
    };
    items.forEach((b) => b.addEventListener('click', () => show(b.dataset.view!)));
    root.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      const i = items.findIndex((b) => b.getAttribute('aria-selected') === 'true');
      const next = ['ArrowDown', 'ArrowRight'].includes(k) ? i + 1 : ['ArrowUp', 'ArrowLeft'].includes(k) ? i - 1 : k === 'Home' ? 0 : k === 'End' ? items.length - 1 : null;
      if (next === null) return;
      e.preventDefault();
      show(items[(next + items.length) % items.length]!.dataset.view!, true);
    });

    // ── pan / zoom ──
    let scale = 1, tx = 0, ty = 0;
    const apply = () => (canvas.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`);
    const zoomAt = (factor: number, cx: number, cy: number) => {
      const next = Math.min(12, Math.max(1, scale * factor));
      const k = next / scale;
      const r = canvas.offsetParent!.getBoundingClientRect();
      const ox = cx - r.left - canvas.offsetLeft, oy = cy - r.top - canvas.offsetTop;
      tx = ox - (ox - tx) * k;
      ty = oy - (oy - ty) * k;
      scale = next;
      if (scale === 1) tx = ty = 0;
      apply();
    };
    const center = () => {
      const r = stage.getBoundingClientRect();
      return [r.left + r.width / 2, r.top + r.height / 2] as const;
    };
    root.querySelector('[data-z="in"]')!.addEventListener('click', () => zoomAt(1.5, ...center()));
    root.querySelector('[data-z="out"]')!.addEventListener('click', () => zoomAt(1 / 1.5, ...center()));
    root.querySelector('[data-z="reset"]')!.addEventListener('click', () => ((scale = 1), (tx = ty = 0), apply()));
    stage.addEventListener(
      'wheel',
      (e) => {
        if (!e.ctrlKey && !e.metaKey) return; // plain scroll keeps scrolling the page
        e.preventDefault();
        zoomAt(Math.exp(-e.deltaY * 0.002), e.clientX, e.clientY);
      },
      { passive: false },
    );
    const pts = new Map<number, { x: number; y: number }>();
    let pinch = 0;
    stage.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('button')) return;
      stage.setPointerCapture(e.pointerId);
      pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
      stage.classList.add('is-dragging');
    });
    stage.addEventListener('pointermove', (e) => {
      const prev = pts.get(e.pointerId);
      if (!prev) return;
      pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pts.size === 2) {
        const [a, b] = [...pts.values()];
        const d = Math.hypot(a!.x - b!.x, a!.y - b!.y);
        if (pinch) zoomAt(d / pinch, (a!.x + b!.x) / 2, (a!.y + b!.y) / 2);
        pinch = d;
      } else if (scale > 1) {
        tx += e.clientX - prev.x;
        ty += e.clientY - prev.y;
        apply();
      }
    });
    const end = (e: PointerEvent) => {
      pts.delete(e.pointerId);
      if (pts.size < 2) pinch = 0;
      if (!pts.size) stage.classList.remove('is-dragging');
    };
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);
  }
</script>
