---
/**
 * Labeled parts on a 2D image (CAD render, photo, drawing).
 *
 * <ImageHotspots
 *   src="rovercad.png" alt="…" caption="…"
 *   points={[{ x: 42.5, y: 18, label: 'Antenna', partNo: 'MT-07', detail: '…' }]} />
 *
 * x / y are percentages of the image width / height. To find them, open the page in
 * `npm run dev` with `?author` on the URL and click the image — the coordinates are
 * copied to your clipboard. Same API shape as <ModelViewer> so a render can later be
 * swapped for a 3D model without rewriting the labels.
 */
import '../../styles/parts.css';
import { Image } from 'astro:assets';
import { resolveImage, type ImageSrc } from '../../lib/media';

interface Point {
  x: number;
  y: number;
  label: string;
  partNo?: string;
  detail: string;
}
interface Props {
  src: ImageSrc;
  alt: string;
  points: Point[];
  caption?: string;
}

const { src, alt, points, caption } = Astro.props;
const img = resolveImage(src, Astro.locals.projectSlug);
const uid = `hs-${Math.random().toString(36).slice(2, 8)}`;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<figure class="parts wide" data-hotspots>
  <div class="parts__layout">
  <div class="parts__stage crop-marks" data-stage>
    <Image src={img} alt={alt} widths={[600, 900, 1200, 1600]} sizes="(min-width: 1100px) 860px, 100vw" />
    {
      points.map((p, i) => (
        <button
          type="button"
          class="parts__marker"
          style={`left:${p.x}%; top:${p.y}%`}
          aria-pressed="false"
          aria-controls={`${uid}-${i}`}
          aria-label={`${pad(i)}: ${p.label}`}
          data-i={i}
        >
          {i + 1}
        </button>
      ))
    }
    <div class="parts__hud">
      <span class="label parts__btn" aria-hidden="true">{points.length} parts · select to inspect</span>
    </div>
  </div>

  <ol class="parts__list" aria-label="Labeled parts">
    {
      points.map((p, i) => (
        <li>
          <button type="button" class="parts__item" id={`${uid}-${i}`} aria-expanded="false" data-i={i}>
            <span class="parts__num">{pad(i)}</span>
            <span class="parts__name">{p.label}</span>
            {p.partNo && <span class="parts__pn label">{p.partNo}</span>}
            <span class="parts__detail">{p.detail}</span>
          </button>
        </li>
      ))
    }
  </ol>
  </div>

  {
    caption && (
      <figcaption class="parts__caption">
        <span class="label" />
        <span>{caption}</span>
      </figcaption>
    )
  }
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-hotspots]')) {
    const markers = [...root.querySelectorAll<HTMLButtonElement>('.parts__marker')];
    const items = [...root.querySelectorAll<HTMLButtonElement>('.parts__item')];
    let active = -1;

    const select = (i: number) => {
      active = active === i ? -1 : i;
      markers.forEach((m, k) => m.setAttribute('aria-pressed', String(k === active)));
      items.forEach((it, k) => it.setAttribute('aria-expanded', String(k === active)));
    };
    const hover = (i: number, on: boolean) => {
      markers[i]?.classList.toggle('is-hover', on);
      items[i]?.classList.toggle('is-hover', on);
    };

    [...markers, ...items].forEach((el) => {
      const i = Number(el.dataset.i);
      el.addEventListener('click', () => select(i));
      el.addEventListener('mouseenter', () => hover(i, true));
      el.addEventListener('mouseleave', () => hover(i, false));
    });

    // Dev-only authoring helper: ?author → click the image to copy x/y percentages.
    if (import.meta.env.DEV && new URLSearchParams(location.search).has('author')) {
      const stage = root.querySelector<HTMLElement>('[data-stage]')!;
      stage.style.cursor = 'crosshair';
      stage.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('button')) return;
        const r = stage.getBoundingClientRect();
        const x = (((e.clientX - r.left) / r.width) * 100).toFixed(1);
        const y = (((e.clientY - r.top) / r.height) * 100).toFixed(1);
        const snippet = `{ x: ${x}, y: ${y}, label: 'TODO', partNo: 'TODO', detail: 'TODO' },`;
        void navigator.clipboard?.writeText(snippet);
        console.info('[hotspot author] copied', snippet);
      });
    }
  }
</script>
