---
/**
 * Overview chart of experience as horizontal bars on a shared time axis, with projects
 * underneath as start → completion bars (diamond = completed). Pure HTML/CSS: each
 * experience bar links to its entry below; hovering / focusing a project shows a card
 * with its photo, name and dates that links to the project page.
 */
import { Image } from 'astro:assets';
import type { Experience, Project } from '../../lib/content';
import { range, duration } from '../../lib/dates';

interface Props {
  entries: Experience[];
  /** Projects drawn on lanes under the experience rows. */
  projects?: Project[];
}

const { entries, projects = [] } = Astro.props;
const now = new Date();
const startYear = Math.min(...entries.map((e) => e.data.start.getUTCFullYear()), ...projects.map((p) => p.data.start.getUTCFullYear()));
const endYear = now.getUTCFullYear() + 1;
const t0 = Date.UTC(startYear, 0, 1);
const t1 = Date.UTC(endYear, 0, 1);
const pct = (d: Date) => ((d.getTime() - t0) / (t1 - t0)) * 100;
// Month-precision ends mean "through the end of that month".
const endOfMonth = (d: Date) => new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + 1, 1));
const years = Array.from({ length: endYear - startYear }, (_, i) => startYear + i);
const rows = [...entries].sort((a, b) => a.data.start.getTime() - b.data.start.getTime());

// Pack projects into as few lanes as possible without overlapping (a small gap keeps
// neighbouring diamonds apart).
const GAP = 1.6; // % of the axis
const spans = [...projects]
  .map((p) => ({ p, left: pct(p.data.start), right: pct(p.data.end ? endOfMonth(p.data.end) : now) }))
  .sort((a, b) => a.left - b.left);
const laneEnds: number[] = [];
const placed = spans.map((s) => {
  let lane = laneEnds.findIndex((end) => end + GAP <= s.left);
  if (lane < 0) lane = laneEnds.push(0) - 1;
  laneEnds[lane] = Math.max(s.right, s.left + 0.6);
  return { ...s, lane };
});
const laneCount = laneEnds.length;
---

<figure class="gantt" aria-label="Experience timeline overview" data-reveal>
  <div class="gantt__scroll">
    <div class="gantt__chart">
      <div class="gantt__axis" aria-hidden="true">
        {
          years.map((y) => (
            <span class="label" style={`left:${pct(new Date(Date.UTC(y, 0, 1)))}%`}>
              {y}
            </span>
          ))
        }
      </div>
      <div class="gantt__rows">
        {
          years.map((y) => <span class="gantt__gridline" style={`left:${pct(new Date(Date.UTC(y, 0, 1)))}%`} aria-hidden="true" />)
        }
        <span class="gantt__now" style={`left:${pct(now)}%`} aria-hidden="true"><span class="label">Now</span></span>
        {
          rows.map((e, i) => {
            const left = pct(e.data.start);
            const right = pct(e.data.end ? endOfMonth(e.data.end) : now);
            const title = e.data.positions[0]!.title;
            // Long bars carry their label inside; short ones put it on whichever side has room.
            const inside = right - left > 34;
            const labelStyle = left > 50 ? `right:${100 - left + 0.8}%; text-align:right` : `left:${right + 0.8}%`;
            return (
              <div class="gantt__row">
                <a
                  href={`#${e.id}`}
                  class:list={['gantt__bar', `gantt__bar--${e.data.type}`, !e.data.end && 'is-ongoing']}
                  style={`left:${left}%; width:${Math.max(right - left, 1.2)}%; --k:${i}`}
                  title={`${e.data.org} · ${range(e.data.start, e.data.end, 'text')} (${duration(e.data.start, e.data.end)})`}
                >
                  <span class="gantt__name">{e.data.mark}</span>
                  {inside && <span class="gantt__inner">{title}</span>}
                </a>
                {!inside && (
                  <span class="gantt__label" style={labelStyle}>
                    {title}
                  </span>
                )}
              </div>
            );
          })
        }
        {
          laneCount > 0 && (
            <div class="gantt__projects" style={`--lanes:${laneCount}`}>
              <span class="gantt__ticks-label label">Projects</span>
              {placed.map(({ p, left, right, lane }, i) => (
                <a
                  href={`/projects/${p.id}`}
                  class:list={['gproj', left > 62 && 'gproj--flip', !p.data.end && 'is-ongoing']}
                  style={`left:${left}%; width:${Math.max(right - left, 0)}%; --lane:${lane}; --k:${i}`}
                  aria-label={`${p.data.title}, ${range(p.data.start, p.data.end, 'text')}`}
                >
                  <span class="gproj__bar" aria-hidden="true" />
                  {p.data.end && <span class="gantt__tick" aria-hidden="true" />}
                  <span class="gproj__card" aria-hidden="true">
                    <Image src={p.data.cover} alt="" widths={[240, 480]} sizes="220px" loading="lazy" />
                    <span class="gproj__title">{p.data.title}</span>
                    <span class="label">{range(p.data.start, p.data.end)}</span>
                  </span>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
  <figcaption class="gantt__legend">
    <span><i class="sw sw--internship"></i>Internship / Co-op</span>
    <span><i class="sw sw--research"></i>Research</span>
    <span><i class="sw sw--team"></i>Team / Leadership</span>
    <span><i class="sw sw--proj"></i><i class="sw sw--tick"></i>Project, start → completed</span>
  </figcaption>
</figure>

<style>
  .gantt {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    padding: var(--s-5) var(--s-5) var(--s-4);
  }

  .gantt__scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  .gantt__chart {
    min-width: 640px;
  }

  .gantt__axis {
    position: relative;
    height: 1.5rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .gantt__axis span {
    position: absolute;
    top: 0;
    transform: translateX(4px);
  }

  .gantt__rows {
    position: relative;
    padding-block: var(--s-3);
  }

  .gantt__gridline {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }

  .gantt__now {
    position: absolute;
    top: -1.5rem;
    bottom: 0;
    width: 1px;
    background: var(--accent);
    z-index: 2;
  }

  .gantt__now .label {
    position: absolute;
    top: 0;
    left: 6px;
    color: var(--accent);
  }

  .gantt__row {
    position: relative;
    height: 2.1rem;
  }

  .gantt__bar {
    position: absolute;
    top: 0.3rem;
    height: 1.5rem;
    display: flex;
    align-items: center;
    padding-inline: 0.5rem;
    border-radius: 2px;
    text-decoration: none;
    overflow: hidden;
    transition:
      filter var(--dur-2) var(--ease),
      transform var(--dur-2) var(--ease);
    z-index: 1;
  }

  .gantt__bar:hover {
    filter: brightness(1.15);
    transform: translateY(-1px);
  }

  .gantt__name {
    font: 600 0.66rem/1 var(--font-mono);
    letter-spacing: 0.05em;
    color: var(--accent-ink);
    white-space: nowrap;
  }

  .gantt__inner {
    margin-left: var(--s-3);
    font-size: var(--step--2);
    white-space: nowrap;
    color: inherit;
    opacity: 0.8;
  }

  .gantt__bar--team .gantt__inner,
  .gantt__bar--leadership .gantt__inner {
    color: var(--text-2);
  }

  .gantt__bar--research .gantt__inner {
    color: var(--bg);
  }

  .gantt__bar--internship .gantt__inner,
  .gantt__bar--co-op .gantt__inner {
    color: var(--accent-ink);
  }

  .gantt__bar--internship,
  .gantt__bar--co-op {
    background: var(--accent);
  }

  .gantt__bar--research {
    background: var(--text);
  }

  .gantt__bar--research .gantt__name {
    color: var(--bg);
  }

  .gantt__bar--team,
  .gantt__bar--leadership {
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .gantt__bar--team .gantt__name,
  .gantt__bar--leadership .gantt__name {
    color: var(--text);
  }

  .gantt__bar.is-ongoing {
    mask-image: linear-gradient(90deg, #000 85%, transparent);
    -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
  }

  .gantt__label {
    position: absolute;
    top: 0.55rem;
    font-size: var(--step--2);
    color: var(--text-2);
    white-space: nowrap;
  }

  /* ── project lanes ── */
  .gantt__projects {
    position: relative;
    height: calc(var(--lanes) * 1.15rem + 1.2rem);
    margin-top: var(--s-2);
    border-top: 1px dashed var(--line);
  }

  .gantt__ticks-label {
    position: absolute;
    right: 0;
    bottom: 0.1rem;
  }

  .gproj {
    position: absolute;
    top: calc(0.6rem + var(--lane) * 1.15rem);
    height: 0.9rem;
    min-width: 0.5rem;
    z-index: 3;
    outline-offset: 3px;
  }

  .gproj:hover,
  .gproj:focus-visible {
    z-index: 6;
  }

  .gproj__bar {
    position: absolute;
    inset: 50% 0 auto 0;
    height: 3px;
    transform: translateY(-50%);
    border-radius: 2px;
    background: var(--accent);
    opacity: 0.5;
    transition: opacity var(--dur-2) var(--ease);
  }

  .gproj.is-ongoing .gproj__bar {
    background: linear-gradient(90deg, var(--accent) 70%, transparent);
  }

  .gantt__tick {
    position: absolute;
    right: 0;
    top: 50%;
    width: 9px;
    height: 9px;
    transform: translate(50%, -50%) rotate(45deg);
    border: 1.5px solid var(--accent);
    background: var(--bg-elev);
    transition: background-color var(--dur-2) var(--ease);
  }

  .gproj:hover .gproj__bar,
  .gproj:focus-visible .gproj__bar {
    opacity: 1;
  }

  .gproj:hover .gantt__tick,
  .gproj:focus-visible .gantt__tick {
    background: var(--accent);
  }

  /* Hover / focus card: photo, name, dates. Opens upward over the experience rows. */
  .gproj__card {
    position: absolute;
    bottom: calc(100% + 8px);
    left: -6px;
    width: 220px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 6px 6px 8px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    opacity: 0;
    transform: translateY(4px);
    pointer-events: none;
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-2) var(--ease);
  }

  .gproj--flip .gproj__card {
    left: auto;
    right: -6px;
  }

  .gproj:hover .gproj__card,
  .gproj:focus-visible .gproj__card {
    opacity: 1;
    transform: none;
  }

  .gproj__card :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 2px;
  }

  .gproj__title {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--text);
    line-height: 1.25;
  }

  .gantt__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-3);
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    font: var(--step--2) var(--font-mono);
    color: var(--text-3);
  }

  .gantt__legend span {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }

  .sw {
    width: 14px;
    height: 8px;
    border-radius: 1px;
  }

  .sw--internship {
    background: var(--accent);
  }

  .sw--research {
    background: var(--text);
  }

  .sw--team {
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .sw--tick {
    width: 8px;
    height: 8px;
    transform: rotate(45deg);
    border: 1.5px solid var(--accent);
    margin-left: -6px;
  }

  .sw--proj {
    width: 18px;
    height: 3px;
    background: var(--accent);
    opacity: 0.6;
  }

  /* Bars grow from their start date the first time the chart scrolls into view. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .gantt:not(.is-in) .gantt__bar {
      transform: scaleX(0);
    }
    .gantt__bar {
      transform-origin: left center;
      transition: transform 0.9s var(--ease) calc(var(--k, 0) * 110ms + 150ms);
    }
    .gproj {
      transition: opacity 0.4s var(--ease) calc(var(--k, 0) * 40ms + 0.8s);
    }
    :global(.js) .gantt:not(.is-in) .gproj {
      opacity: 0;
    }
  }
</style>
