---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="nf">
    <div class="container">
      <p class="label label--accent eyebrow">404</p>
      <h1>Page not found.</h1>
      <p class="lede">This page doesn't exist or has moved.</p>
      <div class="nf__actions">
        <a class="btn btn--primary" href="/">Home</a>
        <a class="btn" href="/projects">Projects</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(5rem, 3rem + 10vw, 10rem);
  }

  h1 {
    margin-top: var(--s-4);
    font-size: var(--step-6);
    letter-spacing: -0.04em;
  }

  .lede {
    margin-top: var(--s-5);
  }


  .nf__actions {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
</style>
