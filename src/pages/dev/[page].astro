---
/**
 * Dev-only component lab: every MDX component on one page, including the 3D viewer
 * against a test fixture. Only exists under `npm run dev` (no paths in production builds).
 * Open http://localhost:4321/dev/components  (add ?author to try the authoring helpers)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Figure from '../../components/media/Figure.astro';
import Gallery from '../../components/media/Gallery.astro';
import Video from '../../components/media/Video.astro';
import CompareSlider from '../../components/media/CompareSlider.astro';
import ImageHotspots from '../../components/media/ImageHotspots.astro';
import ModelViewer from '../../components/media/ModelViewer.astro';
import Lightbox from '../../components/media/Lightbox.astro';
import Diagram from '../../components/data/Diagram.astro';
import SpecSheet from '../../components/data/SpecSheet.astro';
import Callout from '../../components/ui/Callout.astro';
import { getEntry } from 'astro:content';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { page: 'components' } }] : [];
}

Astro.locals.projectSlug = 'typhoon-bgc';
const hasFixture = !!(await getEntry('models', 'zz-fixture'));
---

<BaseLayout title="Component lab" noindex>
  <div class="container" style="padding-block: 4rem">
    <p class="label label--accent eyebrow">Dev only</p>
    <h1 style="font-size: var(--step-5); margin-top: 1rem">Component lab</h1>
    <div class="prose" style="margin-top: 3rem">
      <h2>ModelViewer</h2>
      {hasFixture ? <ModelViewer id="zz-fixture" caption="Test fixture — run scripts in docs/3D-MODELS.md to add real models." /> : <p>No zz-fixture model registered.</p>}
      <h2>ImageHotspots</h2>
      <ImageHotspots src="mr-toad/rovercad.png" alt="Rover render" caption="2D hotspots" points={[{ x: 40.5, y: 9, label: 'Antenna', detail: 'Example.' }]} />
      <h2>CompareSlider</h2>
      <CompareSlider before="atm-driver.png" after="atm-driver.png" beforeLabel="A" afterLabel="B" alt="Same image twice" caption="Wipe between two aligned images." />
      <h2>Diagram</h2>
      <Diagram id="eevi-signal-chain" caption="Block diagram from YAML." />
      <h2>Figure, Gallery, Video, SpecSheet, Callout</h2>
      <Figure src="storm.jpg" alt="Board" caption="Figure with caption." contain />
      <Gallery columns={3} items={[{ src: 'img-7389.jpg', alt: 'a' }, { src: 'img-7873.jpg', alt: 'b' }, { src: 'storm.jpg', alt: 'c' }]} caption="Gallery." />
      <Video src="/media/glider/competition-throw.mp4" caption="Video." />
      <SpecSheet specs={[{ label: 'Mass', value: '1.08 kg' }, { label: 'Span', value: '450 mm' }]} title="SpecSheet" />
      <Callout tone="lesson">Callout body.</Callout>
    </div>
  </div>
  <Lightbox />
</BaseLayout>
