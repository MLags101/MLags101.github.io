---
import { Image, getImage } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import Lightbox from '../components/media/Lightbox.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../site.config';
import portrait from '../assets/site/portrait.jpg';
import team from '../assets/site/robojackets-team.jpg';
import studio from '../assets/site/invention-studio.jpg';
import shop from '../assets/site/machine-shop.jpg';
import rook from '../assets/site/lathe-rook.jpg';
import field from '../assets/site/urc-selfie.jpg';
import jpl from '../assets/site/personal-jpl.jpg';
import desert from '../assets/site/personal-desert.jpg';
import hike from '../assets/site/personal-hike.jpg';
import intrepid from '../assets/site/personal-intrepid.jpg';
import robonav from '../assets/site/personal-robonav.jpg';
import urcFriends from '../assets/site/personal-urc-friends.jpg';
import reagan from '../assets/site/personal-reagan-library.jpg';
import vr from '../assets/site/personal-vr.jpg';

// "Outside the lab" grid, in order. wide = landscape photo spanning two columns.
const personal = await Promise.all(
  [
    { src: jpl, alt: 'Michael standing in front of the NASA Jet Propulsion Laboratory sign during a tour', caption: 'Touring NASA JPL', wide: true },
    { src: desert, alt: 'Selfie in a NASA cap and orange hood in the Utah desert', caption: 'URC · Utah desert' },
    { src: hike, alt: 'Michael standing on a granite outcrop on a hike, with trees and hills behind', caption: 'On a hike' },
    { src: intrepid, alt: 'Selfie on the flight deck of the USS Intrepid with jets and the Manhattan skyline behind', caption: 'USS Intrepid · New York' },
    { src: robonav, alt: 'Michael giving a shaka among RoboNav teammates in red shirts at the competition', caption: 'RoboNav at URC', wide: true },
    { src: urcFriends, alt: 'Michael and a friend in sun hats and competition lanyards at URC', caption: 'Friends at URC' },
    { src: reagan, alt: 'Selfie in the Air Force One pavilion at the Reagan Presidential Library', caption: 'Reagan Library' },
    { src: vr, alt: 'Michael wearing a mixed-reality headset in a lab', caption: 'Trying out VR' },
  ].map(async (p) => ({ ...p, full: await getImage({ src: p.src, width: Math.min(p.src.width, 2000), quality: 80 }) })),
);
---

<PageLayout
  title="About"
  eyebrow={site.identity.join(' / ')}
  lede="Aerospace Engineering BS/MS student at Georgia Tech, minoring in Robotics."
  image={portrait}
>
  <div class="container about">
    <div class="about__grid">
      <figure class="about__portrait crop-marks">
        <Image src={portrait} alt="Michael Lagana in the Utah desert at the University Rover Challenge" widths={[400, 700, 1000]} sizes="(min-width: 900px) 420px, 100vw" loading="eager" />
        <figcaption class="label">URC · Utah</figcaption>
      </figure>

      <div class="about__text">
        <p>
          My focus is autonomous flying vehicles and mechatronics, which I've pursued through research and
          through independent projects, many of which are documented on this site.
        </p>
        <p>
          I've worked as a systems test engineering intern at AV's MacCready Works, including on the Skyfall
          Mars helicopter program, and as an electrical engineering co-op at the Georgia Tech Research
          Institute. I'm now an undergraduate researcher in the Aerospace Robotics Lab, building a group of
          swarm drones that will work together to manipulate their environment.
        </p>
        <p>
          At the Invention Studio makerspace I volunteer as Electronics Master and Prototyping Instructor,
          helping students and faculty build their projects. I also led the drone team at RoboNav, developing
          a Mars reconnaissance UAV for the University Rover Challenge.
        </p>

        <dl class="facts">
          <div>
            <dt class="label">Studying</dt>
            <dd>{site.education.degree}<br /><span class="muted">{site.education.minor && <>Minor in {site.education.minor} · </>}{site.education.detail}</span></dd>
          </div>
          <div>
            <dt class="label">Graduation</dt>
            <dd>{site.education.graduation}</dd>
          </div>
          <div>
            <dt class="label">Based in</dt>
            <dd>{site.location}</dd>
          </div>
          {
            site.availability && (
              <div>
                <dt class="label">Looking for</dt>
                <dd>{site.availability}</dd>
              </div>
            )
          }
        </dl>

        <div class="about__links">
          <a class="btn btn--primary" href={`mailto:${site.email}`}><Icon name="mail" /> Email me</a>
          <a class="btn" href={site.links.linkedin} target="_blank" rel="me noopener"><Icon name="linkedin" /> LinkedIn</a>
          <a class="btn" href={site.resumePdf} download><Icon name="download" /> Resume</a>
        </div>
      </div>
    </div>

    <section class="about__gallery" aria-label="Photos">
      <figure class="crop-marks">
        <Image src={team} alt="The RoboJackets RoboNav team in front of the team trailer" widths={[600, 900, 1300]} sizes="(min-width: 900px) 60vw, 100vw" />
        <figcaption class="label">RoboNav · RoboJackets</figcaption>
      </figure>
      <figure class="crop-marks">
        <Image src={studio} alt="Workbenches and machines inside the Georgia Tech Invention Studio" widths={[500, 800]} sizes="(min-width: 900px) 35vw, 100vw" />
        <figcaption class="label">Invention Studio · Georgia Tech</figcaption>
      </figure>
    </section>
    <section class="about__gallery about__gallery--row" aria-label="More photos">
      <figure class="crop-marks">
        <Image src={shop} alt="Michael and two friends in safety glasses in a machine shop, next to a manual mill" widths={[500, 800, 1100]} sizes="(min-width: 900px) 48vw, 100vw" />
        <figcaption class="label">In the machine shop</figcaption>
      </figure>
      <figure class="crop-marks">
        <Image src={rook} alt="A small aluminum chess rook, freshly turned on a lathe, held up in hand" widths={[400, 700]} sizes="(min-width: 900px) 26vw, 100vw" />
        <figcaption class="label">A rook turned on the lathe</figcaption>
      </figure>
      <figure class="crop-marks">
        <Image src={field} alt="Michael in a camo bucket hat and sunglasses under a canopy tent at a field site" widths={[400, 700]} sizes="(min-width: 900px) 26vw, 100vw" />
        <figcaption class="label">Out in the field</figcaption>
      </figure>
    </section>

    <section class="personal" aria-labelledby="personal-title">
      <h2 id="personal-title" class="personal__title">Outside the lab</h2>
      <div class="personal__grid" data-gallery>
        {
          personal.map((p) => (
            <figure class:list={['personal__item', p.wide && 'is-wide']}>
              <a href={p.full.src} data-pswp-width={p.full.attributes.width ?? p.src.width} data-pswp-height={p.full.attributes.height ?? p.src.height} data-caption={p.caption}>
                <Image src={p.src} alt={p.alt} widths={p.wide ? [480, 800, 1100] : [300, 500, 700]} sizes={p.wide ? '(min-width: 900px) 40vw, 100vw' : '(min-width: 900px) 20vw, 50vw'} />
              </a>
              <figcaption class="label">{p.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>
  </div>
  <Lightbox />
</PageLayout>

<style>
  .personal {
    margin-top: var(--s-9);
  }

  .personal__title {
    font-size: var(--step-3);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--line-strong);
  }

  /* Five columns: portraits take one, landscape photos two, so rows line up at 3:4 / 3:2. */
  .personal__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--s-4);
    margin-top: var(--s-5);
  }

  .personal__item.is-wide {
    grid-column: span 2;
  }

  .personal__item a {
    display: block;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: zoom-in;
  }

  .personal__item :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    transition: transform var(--dur-3) var(--ease);
  }

  /* Wide photos fill whatever height the portraits in their row set. */
  .personal__item {
    display: flex;
    flex-direction: column;
  }

  .personal__item.is-wide a {
    position: relative;
    flex: 1;
  }

  .personal__item.is-wide :global(img) {
    position: absolute;
    inset: 0;
    height: 100%;
    aspect-ratio: auto;
  }

  .personal__item a:hover :global(img) {
    transform: scale(1.03);
  }

  @media (max-width: 900px) {
    .personal__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .personal__item.is-wide a {
      aspect-ratio: 3 / 2;
    }
  }

  .about {
    padding-block: var(--s-8) var(--section);
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--s-8);
    align-items: start;
  }

  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
  }

  .about__portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  figcaption {
    margin-top: var(--s-2);
  }

  .about__text p {
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--text-2);
    max-width: 60ch;
  }

  .about__text p + p {
    margin-top: var(--s-5);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  .facts dd {
    margin-top: var(--s-2);
    font-size: var(--step--1);
  }

  .about__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-7);
  }

  .about__gallery {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--s-5);
    margin-top: var(--s-9);
  }

  .about__gallery :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  /* Landscape 4:3 + two 3:4 portraits at the same height: columns in a 16 : 9 : 9 ratio. */
  .about__gallery--row {
    grid-template-columns: 16fr 9fr 9fr;
    margin-top: var(--s-7);
  }

  .about__gallery--row figure:first-child :global(img) {
    aspect-ratio: 4 / 3;
  }

  .about__gallery--row figure:not(:first-child) :global(img) {
    aspect-ratio: 3 / 4;
  }

  @media (max-width: 700px) {
    .about__gallery.about__gallery--row {
      grid-template-columns: 1fr 1fr;
    }
    .about__gallery--row figure:first-child {
      grid-column: 1 / -1;
    }
    .about__gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
