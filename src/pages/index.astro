---
import fs from 'node:fs';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/cards/ProjectCard.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../site.config';
import {
  getFeaturedProjects,
  getProjects,
  getExperience,
  getSkills,
  getSkillUsage,
  EXPERIENCE_LABELS,
  SKILL_GROUP_LABELS,
} from '../lib/content';
import { range } from '../lib/dates';

const featured = await getFeaturedProjects();
const [lead, ...rest] = featured;
const projects = await getProjects();
const experience = await getExperience();
const current = experience.filter((e) => !e.data.end && e.data.type !== 'leadership');
const latestPast = experience.find((e) => e.data.end);

const skills = await getSkills();
const usage = await getSkillUsage();
const groups = Object.entries(SKILL_GROUP_LABELS).map(([key, label]) => ({
  key,
  label,
  skills: skills
    .filter((s) => s.data.group === key && (s.data.resume || (usage.get(s.id)?.length ?? 0) > 0))
    .map((s) => ({ ...s, count: usage.get(s.id)?.length ?? 0 }))
    .sort((a, b) => b.count - a.count || a.data.name.localeCompare(b.data.name)),
}));

// Hero slideshow (site.yaml → heroSlides). A missing file fails the build instead of showing black.
const slides = site.heroSlides.map((s) => ({ ...s, poster: s.video ? (s.poster ?? s.video.replace(/\.mp4$/, '.jpg')) : undefined }));
for (const s of slides)
  for (const p of [s.image, s.video, s.poster])
    if (p && !fs.existsSync(`public${p}`)) throw new Error(`site.yaml → heroSlides: "${p}" not found in public/`);
const firstStill = slides[0]!.image ?? slides[0]!.poster!;

const firstYear = Math.min(...projects.map((p) => p.data.start.getUTCFullYear()));
const stats = [
  { value: String(projects.length), label: 'Projects' },
  { value: String(experience.length), label: 'Roles' },
  { value: String(projects.filter((p) => p.data.makerGrant).length), label: 'Maker Grants' },
  { value: String(new Date().getUTCFullYear() - firstYear + 1), label: 'Years of projects' },
];
---

<BaseLayout hasHero>
  <link slot="head" rel="preload" as="image" href={firstStill} fetchpriority="high" />
  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media" aria-hidden="true" data-hero-slides>
      {
        slides.map((s, i) =>
          s.video ? (
            <video
              class:list={['hero__slide', i === 0 && 'is-active']}
              data-slide
              data-seconds={s.seconds}
              src={i === 0 ? s.video : undefined}
              data-src={i === 0 ? undefined : s.video}
              poster={i === 0 ? s.poster : undefined}
              data-poster={i === 0 ? undefined : s.poster}
              muted
              loop
              playsinline
              preload="none"
            />
          ) : (
            <img
              class:list={['hero__slide', i === 0 && 'is-active']}
              data-slide
              data-seconds={s.seconds}
              src={i === 0 ? s.image : undefined}
              data-src={i === 0 ? undefined : s.image}
              alt=""
              decoding="async"
            />
          ),
        )
      }
      <div class="hero__scrim"></div>
      <div class="hero__grid"></div>
    </div>

    <div class="container hero__content">
      <p class="label hero__kicker">
        <span class="dot dot--accent"></span>
        {site.education.degree} · {site.education.minor && <>Minor in {site.education.minor} · </>}Georgia Tech · {site.education.graduation.replace('Expected ', 'Class of ').replace(/May /, '')}
      </p>
      <h1 id="hero-title" class="hero__title">{site.name}</h1>
      {
        site.identity.length > 0 && (
          <p class="hero__identity mono">
            {site.identity.map((t, i) => (
              <span style={`--k:${i}`}>{t}</span>
            ))}
          </p>
        )
      }
      <p class="hero__tagline">{site.tagline}</p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="/projects">Projects <Icon name="arrow-right" /></a>
        <a class="btn hero__btn" href="/experience">Experience</a>
        <a class="btn hero__btn" href={site.resumePdf} download><Icon name="download" /> Resume</a>
      </div>
    </div>

    <div class="hero__hud">
      <div class="container hero__hud-inner">
        {
          current.slice(0, 1).map((e) => (
            <div>
              <span class="label">Now</span>
              <span>
                {e.data.positions[0]!.title} — {e.data.org.split(' · ')[0]}
              </span>
            </div>
          ))
        }
        {
          latestPast && (
            <div>
              <span class="label">Recent</span>
              <span>
                {latestPast.data.positions[0]!.title} — {latestPast.data.org}
              </span>
            </div>
          )
        }
        <div class="hero__hud-footage">
          <span class="label">Footage</span>
          <a class="hero__caption" href={slides[0]!.href ?? '/projects'} data-hero-caption>{slides[0]!.caption}</a>
          {
            slides.length > 1 && (
              <div class="hero__controls">
                <button type="button" class="hero__toggle" data-hero-toggle aria-label="Pause slideshow" aria-pressed="false">
                  <Icon name="pause" size={14} class="hero__icon-pause" />
                  <Icon name="play" size={12} class="hero__icon-play" />
                </button>
                <div class="hero__dots" role="group" aria-label="Choose footage">
                  {slides.map((s, i) => (
                    <button
                      type="button"
                      class:list={['hero__dot', i === 0 && 'is-active']}
                      data-hero-dot={i}
                      data-caption={s.caption}
                      data-href={s.href ?? '/projects'}
                      aria-label={`Show ${s.caption}`}
                      aria-current={i === 0 ? 'true' : undefined}
                    />
                  ))}
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ── Stats ────────────────────────────────────────────── -->
  <section class="stats" aria-label="At a glance">
    <div class="container">
      <dl class="stats__grid">
        {
          stats.map((s, i) => (
            <div data-reveal style={`--reveal-i:${i}`}>
              <dt class="label">{s.label}</dt>
              <dd data-count={s.value}>{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ── Selected work ────────────────────────────────────── -->
  <section class="section" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 id="work-title">Selected projects</h2>
        </div>
        <a class="link-arrow" href="/projects">All {projects.length} projects</a>
      </div>

      {lead && <ProjectCard project={lead} variant="feature" headingLevel="h3" priority />}
      <div class="work-grid">
        {rest.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ── Experience snapshot ──────────────────────────────── -->
  <section class="section" aria-labelledby="exp-title">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 id="exp-title">Experience</h2>
        </div>
        <a class="link-arrow" href="/experience">Full timeline</a>
      </div>

      <ol class="exp-list">
        {
          experience.slice(0, 6).map((e, i) => (
            <li data-reveal style={`--reveal-i:${i % 4}`}>
              <a href={`/experience#${e.id}`} class="exp-row">
                {e.data.logo ? (
                  <Image src={e.data.logo} alt="" class="exp-row__logo" widths={[96]} sizes="52px" />
                ) : (
                  <span class="exp-row__mark mono" aria-hidden="true">
                    {e.data.mark}
                  </span>
                )}
                <span class="exp-row__main">
                  <span class="exp-row__title">{e.data.positions[0]!.title}</span>
                  <span class="exp-row__org">{e.data.org}</span>
                </span>
                <span class="exp-row__type label">{EXPERIENCE_LABELS[e.data.type]}</span>
                <span class="exp-row__date mono">{range(e.data.start, e.data.end)}</span>
                <Icon name="arrow-right" class="exp-row__arrow" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ── Capabilities ─────────────────────────────────────── -->
  <section class="section" aria-labelledby="cap-title">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 id="cap-title">Tools</h2>
          <p>Number of projects on this site that use each tool. Select one to see them.</p>
        </div>
      </div>

      <div class="cap-grid">
        {
          groups.map((g, gi) => (
            <section class="cap" data-reveal style={`--reveal-i:${gi % 3}`}>
              <h3 class="label">{g.label}</h3>
              <ul>
                {g.skills.map((s) => (
                  <li>
                    {s.count > 0 ? (
                      <a href={`/projects?skill=${s.id}`} class="cap__row">
                        <span>{s.data.name}</span>
                        <span class="cap__leader" aria-hidden="true" />
                        <span class="mono cap__count">{String(s.count).padStart(2, '0')}</span>
                      </a>
                    ) : (
                      <span class="cap__row cap__row--static">
                        <span>{s.data.name}</span>
                        <span class="cap__leader" aria-hidden="true" />
                        <span class="mono cap__count">—</span>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── hero ── */
  .hero {
    position: relative;
    min-height: min(100svh, 980px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: #e8eaed;
    isolation: isolate;
    overflow: hidden;
    background: #08090b;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }

  .hero__slide.is-active {
    opacity: 1;
  }

  /* Slow push-in on stills while they're up. */
  img.hero__slide.is-active {
    animation: hero-drift var(--slide-s, 7s) linear both;
  }

  @keyframes hero-drift {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide {
      transition: none;
    }
    img.hero__slide.is-active {
      animation: none;
    }
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(8 9 11 / 0.85) 0%, rgb(8 9 11 / 0.35) 55%, rgb(8 9 11 / 0.1) 100%),
      linear-gradient(180deg, rgb(8 9 11 / 0.5) 0%, transparent 25%, transparent 55%, rgb(8 9 11 / 0.95) 100%);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(90deg, #000 0%, transparent 60%);
    -webkit-mask-image: linear-gradient(90deg, #000 0%, transparent 60%);
  }

  .hero__content {
    padding-top: calc(var(--header-h) + var(--s-9));
    padding-bottom: var(--s-8);
  }

  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    color: #c9ced5;
  }

  .hero__title {
    margin-top: var(--s-5);
    font-size: clamp(3.2rem, 1.4rem + 8vw, 8.5rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .hero__identity {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-3);
    margin-top: var(--s-4);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #e8eaed;
  }

  .hero__identity span + span::before {
    content: '/';
    margin-right: var(--s-3);
    color: var(--accent);
  }

  .hero__tagline {
    margin-top: var(--s-5);
    max-width: 34ch;
    font-size: var(--step-2);
    line-height: 1.35;
    color: #c9ced5;
    letter-spacing: -0.01em;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .hero__btn {
    color: #e8eaed;
    border-color: rgb(255 255 255 / 0.25);
    background: rgb(8 9 11 / 0.35);
    backdrop-filter: blur(6px);
  }

  .hero__btn:hover {
    background: rgb(255 255 255 / 0.08);
    border-color: rgb(255 255 255 / 0.5);
  }

  .hero__hud {
    border-top: 1px solid rgb(255 255 255 / 0.12);
    background: rgb(8 9 11 / 0.55);
    backdrop-filter: blur(10px);
  }

  .hero__hud-inner {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
    padding-block: var(--s-4);
    font-size: var(--step--1);
    color: #c9ced5;
  }

  .hero__hud-inner > div {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    min-width: 0;
  }

  .hero__hud-inner .label {
    color: #8b929c;
  }

  .hero__hud-footage {
    align-items: flex-end;
    text-align: right;
  }

  .hero__caption {
    color: inherit;
    text-decoration: none;
  }

  .hero__caption:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero__controls {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-1);
  }

  .hero__toggle {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 50%;
    background: none;
    color: #c9ced5;
    cursor: pointer;
  }

  .hero__toggle:hover {
    border-color: rgb(255 255 255 / 0.6);
    color: #fff;
  }

  .hero__toggle :global(.hero__icon-play),
  .hero__toggle[aria-pressed='true'] :global(.hero__icon-pause) {
    display: none;
  }

  .hero__toggle[aria-pressed='true'] :global(.hero__icon-play) {
    display: block;
  }

  .hero__dots {
    display: flex;
    gap: 6px;
  }

  .hero__dot {
    position: relative;
    width: 22px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  /* The visible bar is 3px tall; the button keeps a 24px touch target. */
  .hero__dot::before,
  .hero__dot::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 3px;
    margin-top: -1.5px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.25);
  }

  .hero__dot::after {
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .hero__dot:hover::before {
    background: rgb(255 255 255 / 0.55);
  }

  .hero__dot.is-active::after {
    transform: scaleX(1);
  }

  .hero__dot.is-running::after {
    animation: hero-progress var(--slide-s, 7s) linear both;
  }

  @keyframes hero-progress {
    from {
      transform: scaleX(0);
    }
  }

  @media (max-width: 760px) {
    .hero__hud-inner {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
    .hero__hud-footage {
      align-items: flex-start;
      text-align: left;
    }
  }

  /* ── stats ── */
  .stats {
    border-bottom: 1px solid var(--line);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .stats__grid > div {
    padding: var(--s-6) var(--s-5);
    border-left: 1px solid var(--line);
  }

  .stats__grid > div:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .stats dd {
    margin-top: var(--s-2);
    font-size: var(--step-5);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 760px) {
    .stats__grid {
      grid-template-columns: 1fr 1fr;
    }
    .stats__grid > div:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .stats__grid > div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  /* ── work ── */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--s-7) var(--s-6);
    margin-top: var(--s-8);
  }

  /* ── experience ── */
  .exp-list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .exp-row {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr) 8rem 12rem 1.25rem;
    align-items: center;
    gap: var(--s-5);
    padding: var(--s-5) var(--s-2);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: background-color var(--dur-2) var(--ease);
  }

  .exp-row:hover {
    background: var(--bg-elev);
  }

  .exp-row__mark {
    display: grid;
    place-items: center;
    height: 2.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition:
      border-color var(--dur-2) var(--ease),
      color var(--dur-2) var(--ease);
  }

  .exp-row:hover .exp-row__mark {
    border-color: var(--accent);
    color: var(--accent);
  }

  .exp-row :global(.exp-row__logo) {
    width: 2.5rem;
    height: 2.5rem;
    justify-self: center;
    border-radius: var(--radius);
    object-fit: cover;
  }

  .exp-row__main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .exp-row__title {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .exp-row__org {
    color: var(--text-2);
    font-size: var(--step--1);
  }

  .exp-row__date {
    font-size: var(--step--1);
    color: var(--text-2);
    text-align: right;
  }

  .exp-row :global(.exp-row__arrow) {
    color: var(--text-3);
    transition:
      transform var(--dur-2) var(--ease),
      color var(--dur-2) var(--ease);
  }

  .exp-row:hover :global(.exp-row__arrow) {
    transform: translateX(3px);
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .exp-row {
      grid-template-columns: 2.75rem minmax(0, 1fr);
      gap: var(--s-2) var(--s-4);
    }
    .exp-row__type,
    .exp-row :global(.exp-row__arrow) {
      display: none;
    }
    .exp-row__date {
      grid-column: 2;
      text-align: left;
    }
  }

  /* ── capabilities ── */
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--s-7) var(--s-6);
  }

  .cap h3 {
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--line-strong);
    color: var(--text);
  }

  .cap ul {
    list-style: none;
    padding: 0;
  }

  .cap__row {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    padding-block: 0.45rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--text);
  }

  .cap__row--static {
    color: var(--text-2);
  }

  .cap__leader {
    flex: 1;
    border-bottom: 1px dotted var(--line-strong);
    transform: translateY(-3px);
  }

  .cap__count {
    font-size: var(--step--2);
    color: var(--text-3);
  }

  a.cap__row:hover {
    color: var(--accent);
  }

  a.cap__row:hover .cap__count {
    color: var(--accent);
  }
</style>

<script>
  // Stats count up once when they scroll into view (final values are in the HTML already).
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const counters = [...document.querySelectorAll<HTMLElement>('[data-count]')];
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const to = Number(el.dataset.count);
        const t0 = performance.now();
        const tick = (now: number) => {
          const k = Math.min(1, (now - t0) / 900);
          el.textContent = String(Math.round(to * (1 - (1 - k) ** 3)));
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.6 });
    counters.forEach((c) => io.observe(c));
  }

  // ── Hero slideshow: crossfades through site.yaml → heroSlides. A slide's media loads just
  // before it's shown. Nothing auto-advances under reduced motion (the dots still work).
  const stage = document.querySelector<HTMLElement>('[data-hero-slides]');
  const slideEls = stage ? [...stage.querySelectorAll<HTMLImageElement | HTMLVideoElement>('[data-slide]')] : [];
  const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-hero-dot]')];
  const caption = document.querySelector<HTMLAnchorElement>('[data-hero-caption]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  if (stage && slideEls.length) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;
    let primeTimer: number | undefined;
    let paused = reduce;
    let onScreen = true;
    let started = false;

    const isVideo = (el: Element): el is HTMLVideoElement => el instanceof HTMLVideoElement;
    const prime = (el: HTMLElement) => {
      if (el.dataset.poster) (el as HTMLVideoElement).poster = el.dataset.poster;
      if (el.dataset.src) {
        el.setAttribute('src', el.dataset.src);
        delete el.dataset.src;
      }
    };

    const run = () => {
      if (!started) return;
      window.clearTimeout(timer);
      window.clearTimeout(primeTimer);
      const el = slideEls[current]!;
      const dot = dots[current];
      const secs = Number(el.dataset.seconds) || 7;
      stage.style.setProperty('--slide-s', `${secs}s`);
      dot?.style.setProperty('--slide-s', `${secs}s`);
      dot?.classList.remove('is-running');
      if (paused || !onScreen || document.hidden) {
        if (isVideo(el)) el.pause();
        return;
      }
      if (isVideo(el)) {
        el.preload = 'auto';
        void el.play().catch(() => {});
      }
      if (slideEls.length > 1) {
        if (dot) {
          void dot.offsetWidth; // restart the progress bar
          dot.classList.add('is-running');
        }
        timer = window.setTimeout(() => show(current + 1), secs * 1000);
        // Fetch the next slide a few seconds before it shows, not while this one is loading.
        const next = slideEls[(current + 1) % slideEls.length]!;
        primeTimer = window.setTimeout(() => prime(next), Math.max(0, secs - 3) * 1000);
      }
    };

    const show = (n: number) => {
      const prev = slideEls[current]!;
      current = (n + slideEls.length) % slideEls.length;
      const el = slideEls[current]!;
      prime(el);
      if (isVideo(el)) el.currentTime = 0;
      if (prev !== el) {
        prev.classList.remove('is-active');
        el.classList.add('is-active');
        // Stop the outgoing video once it has faded out.
        if (isVideo(prev)) window.setTimeout(() => !prev.classList.contains('is-active') && prev.pause(), 1300);
      }
      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i === current);
        if (i === current) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
      const dot = dots[current];
      if (caption && dot) {
        caption.textContent = dot.dataset.caption ?? '';
        caption.href = dot.dataset.href ?? '/projects';
      }
      run();
    };

    const setPaused = (p: boolean) => {
      paused = p;
      toggle?.setAttribute('aria-pressed', String(p));
      toggle?.setAttribute('aria-label', p ? 'Play slideshow' : 'Pause slideshow');
      run();
    };

    dots.forEach((d, i) => d.addEventListener('click', () => show(i)));
    toggle?.addEventListener('click', () => setPaused(!paused));
    if (reduce) setPaused(true);
    // Pause when scrolled away or the tab is hidden to save battery/CPU.
    new IntersectionObserver(([e]) => {
      onScreen = !!e?.isIntersecting;
      run();
    }).observe(stage);
    document.addEventListener('visibilitychange', run);
    // Start after the page has loaded so the first video doesn't compete with first paint.
    const start = () => {
      started = true;
      run();
    };
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }
</script>
